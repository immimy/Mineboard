{
  "name": "mineboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck",
    "test:browser": "vitest --config vitest.config.mts",
    "test:node": "vitest --config vitest.node.config.mts",
    "test": "vitest --config vitest.config.mts && vitest --config vitest.node.config.mts",
    "codegen": "graphql-codegen --config codegen.ts --watch",
    "database-type": "supabase gen types typescript --local --schema public > supabase/database.types.ts",
    "dev:db-reset": "supabase db reset && npm run dev:codegen-enabler && npm run dev:vault-setup && npm run dev:cloudinaryCleanup && npm run mock-data:dev",
    "dev:cloudinaryCleanup": "node --env-file=.env.local scripts/image-cleanup/devImagesCleanup.mjs",
    "dev:codegen-enabler": "supabase db query --local --file supabase/snippets/grant_public_to_anon.sql",
    "dev:vault-setup": "supabase db query --local --file supabase/snippets/image_cleanup_vault.sql",
    "mock-data:dev": "node --env-file=.env.local scripts/mock-data/seed.mjs --environment=development",
    "mock-data:production": "node --env-file=.env.seed.production scripts/mock-data/seed.mjs --environment=production"
  },
  "dependencies": {
    "@apollo/client": "4.2.10",
    "@apollo/client-integration-nextjs": "0.14.5",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@headlessui/react": "2.2.10",
    "@supabase/ssr": "0.9.0",
    "@supabase/supabase-js": "2.112.2",
    "cloudinary": "2.10.0",
    "dayjs": "1.11.21",
    "embla-carousel-react": "8.6.0",
    "graphql": "16.14.2",
    "next": "16.3.4",
    "next-cloudinary": "6.17.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.84.0",
    "react-toastify": "11.1.0",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "6.3.1",
    "@parcel/watcher": "2.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser-playwright": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vitest-browser-react": "2.2.0"
  }
}
